# Banco (desenvolvimento local: docker compose up -d)
DATABASE_URL="postgresql://pop:pop@localhost:5432/popdashboard?schema=public"
# Conexão direta, usada nas migrações. Local: a mesma URL. Supabase: veja DEPLOY-VERCEL.md
DIRECT_URL="postgresql://pop:pop@localhost:5432/popdashboard?schema=public"

# Troque por uma string longa e aleatória (mín. 32 caracteres)
SESSION_SECRET="troque-esta-chave-por-uma-string-longa-e-aleatoria-1234567890"

# "false" fecha o cadastro de novas contas
ALLOW_REGISTER="true"

# URL pública do app (usada nos links do e-mail de recuperação de senha)
# APP_URL="https://seu-app.a.run.app"

# E-mail (opcional). Sem SMTP_HOST o link de recuperação só aparece no log do servidor.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu@gmail.com"
# SMTP_PASS="senha-de-app"
# MAIL_FROM="Pop Dashboard <seu@gmail.com>"
